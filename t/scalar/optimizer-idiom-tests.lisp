(cl:in-package :cl-cc/optimize/scalar/test)

(defun idiom-zero-fill-loop ()
  (list (cl-cc/vm:make-vm-const :dst :rzero :value 0)
        (make-vm-array-length :dst :rlen :src :rvec)
        (cl-cc/vm:make-vm-const :dst :ri :value 0)
        (cl-cc/vm:make-vm-label :name "Lmemset")
        (make-vm-lt :dst :rcond :lhs :ri :rhs :rlen)
        (cl-cc/vm:make-vm-jump-zero :reg :rcond :label "Lmemset-exit")
        (cl-cc/vm:make-vm-aset :array-reg :rvec :index-reg :ri :val-reg :rzero)
        (cl-cc/vm:make-vm-const :dst :rone :value 1)
        (cl-cc/vm:make-vm-add :dst :rnext :lhs :ri :rhs :rone)
        (cl-cc/vm:make-vm-move :dst :ri :src :rnext)
        (cl-cc/vm:make-vm-jump :label "Lmemset")
        (cl-cc/vm:make-vm-label :name "Lmemset-exit")))

(defun idiom-copy-loop (&key strided-p)
  (list (cl-cc/vm:make-vm-const :dst :rsize :value 4)
        (cl-cc/vm:make-vm-make-array :dst :rdst :size-reg :rsize)
        (cl-cc/vm:make-vm-make-array :dst :rsrc :size-reg :rsize)
        (make-vm-array-length :dst :rlen :src :rsrc)
        (cl-cc/vm:make-vm-const :dst :ri :value 0)
        (cl-cc/vm:make-vm-label :name "Lmemcpy")
        (make-vm-lt :dst :rcond :lhs :ri :rhs :rlen)
        (cl-cc/vm:make-vm-jump-zero :reg :rcond :label "Lmemcpy-exit")
        (cl-cc/vm:make-vm-aref :dst :rtmp :array-reg :rsrc :index-reg :ri)
        (cl-cc/vm:make-vm-aset :array-reg :rdst :index-reg :ri :val-reg :rtmp)
        (cl-cc/vm:make-vm-const :dst :rone :value (if strided-p 2 1))
        (cl-cc/vm:make-vm-add :dst :rnext :lhs :ri :rhs :rone)
        (cl-cc/vm:make-vm-move :dst :ri :src :rnext)
        (cl-cc/vm:make-vm-jump :label "Lmemcpy")
        (cl-cc/vm:make-vm-label :name "Lmemcpy-exit")))

(defun idiom-popcount-loop ()
  (list (cl-cc/vm:make-vm-const :dst :rcount :value 0)
        (cl-cc/vm:make-vm-label :name "Lpop")
        (cl-cc/vm:make-vm-jump-zero :reg :rx :label "Lpop-exit")
        (cl-cc/vm:make-vm-const :dst :rone :value 1)
        (cl-cc/vm:make-vm-sub :dst :rdec :lhs :rx :rhs :rone)
        (make-vm-logand :dst :rnext :lhs :rx :rhs :rdec)
        (cl-cc/vm:make-vm-add :dst :rcount-next :lhs :rcount :rhs :rone)
        (cl-cc/vm:make-vm-move :dst :rx :src :rnext)
        (cl-cc/vm:make-vm-jump :label "Lpop")
        (cl-cc/vm:make-vm-label :name "Lpop-exit")))

(defun idiom-strlen-loop ()
  (list (cl-cc/vm:make-vm-const :dst :ri :value 0)
        (cl-cc/vm:make-vm-label :name "Lstrlen")
        (cl-cc/vm:make-vm-char :dst :rch :string :rstr :index :ri)
        (cl-cc/vm:make-vm-const :dst :rnul :value #\Nul)
        (cl-cc/vm:make-vm-char= :dst :rcond :char1 :rch :char2 :rnul)
        (cl-cc/vm:make-vm-jump-zero :reg :rcond :label "Lstrlen-body")
        (cl-cc/vm:make-vm-jump :label "Lstrlen-exit")
        (cl-cc/vm:make-vm-label :name "Lstrlen-body")
        (cl-cc/vm:make-vm-const :dst :rone :value 1)
        (cl-cc/vm:make-vm-add :dst :rnext :lhs :ri :rhs :rone)
        (cl-cc/vm:make-vm-move :dst :ri :src :rnext)
        (cl-cc/vm:make-vm-jump :label "Lstrlen")
        (cl-cc/vm:make-vm-label :name "Lstrlen-exit")))

(it-sequential "fr-684-memset-recognition-collapses-zero-fill-loop"
  (let ((result (cl-cc/optimize:opt-pass-idiom-recognition (idiom-zero-fill-loop))))
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-fill)) result) :to-be-truthy)
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-aset)) result) :to-be-falsy)))

(it-sequential "fr-684-memcpy-recognition-collapses-unit-stride-copy-loop"
  (let ((result (cl-cc/optimize:opt-pass-idiom-recognition (idiom-copy-loop))))
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-copy-vector)) result) :to-be-truthy)
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-aset)) result) :to-be-falsy)))

(it-sequential "fr-684-memcpy-recognition-skips-strided-copy-loop"
  (let ((result (cl-cc/optimize:opt-pass-idiom-recognition (idiom-copy-loop :strided-p t))))
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-copy-vector)) result) :to-be-falsy)
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-aset)) result) :to-be-truthy)))

(it-sequential "fr-684-popcount-recognition-emits-logcount"
  (let ((result (cl-cc/optimize:opt-pass-idiom-recognition (idiom-popcount-loop))))
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-logcount)) result) :to-be-truthy)
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-logand)) result) :to-be-falsy)))

(it-sequential "fr-684-strlen-recognition-emits-string-length"
  (let ((result (cl-cc/optimize:opt-pass-idiom-recognition (idiom-strlen-loop))))
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-string-length)) result) :to-be-truthy)
    (expect (some (lambda (i) (typep i 'cl-cc/vm::vm-char)) result) :to-be-falsy)))
